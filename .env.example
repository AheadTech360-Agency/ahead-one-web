# Copy to .env.local and fill in. Every value here is public: NEXT_PUBLIC_* is inlined
# into the browser bundle. Never put a Supabase service role key or any secret in /web.

# Supabase project (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Rust API base URL, without a trailing slash (routes live under /v1)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Firebase Cloud Messaging for web push (Project settings > General, and Cloud Messaging > Web Push certificates)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

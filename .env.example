# Copy to .env.local and fill in. NEXT_PUBLIC_* values are inlined into the browser bundle,
# so never put a secret in them.

# Rust API base URL, without a trailing slash (routes live under /v1). Used by the browser
# for API calls and the WebSocket, and by the sign-in route handlers (/api/auth/*).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional, server only. Where the Next.js server reaches the API (for example a private network
# address). Falls back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=

# Shared secret with the API (same value as BFF_SECRET on Railway, 32+ characters). Server-side only:
# do NOT prefix it with NEXT_PUBLIC. It lets the API trust the real client address this server forwards.
# BFF_SECRET=

# Firebase Cloud Messaging for web push (Project settings > General, and Cloud Messaging > Web Push certificates)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
